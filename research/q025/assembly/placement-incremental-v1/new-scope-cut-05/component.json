{
  "schemaVersion": "q025-admitted-placement-component/1",
  "destinations": [],
  "placements": [
    {
      "unitId": "unit:9d788da67ce82415fb6eafcf3dc801daae1f3a1b47253dfdeed3667971f9012c",
      "destinationId": "q025-placement-question:b7827235a8a5acc6680597ec",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "The proposed scope jointly covers type 0’B D3 dark-bubble construction, scale separation, particle physics, inflation and late acceleration.",
      "qualification": "n0 preserves the specified string theory, D3 construction and all four viability requirements. q19 includes dark bubbles and multiple cosmological epochs, but its definition does not establish coverage of the independent particle-physics and scale-separated construction targets. n0 is retained unchanged as a proposal.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:9d788da67ce82415fb6eafcf3dc801daae1f3a1b47253dfdeed3667971f9012c",
          "paperId": "2502.20438",
          "textSha256": "c13ef5e2ac5a1522d81510479c1a0994f62523401ff9f34313b3ccd10c5d1214"
        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0069:u2:n0"
    },
    {
      "unitId": "unit:04be111e484dcf67f35dbc1b917e98f22fca36b0513f5d52dad34cb942207c66",
      "destinationId": "q025-placement-question:389b82e951e66e2292dd8950",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "The proposed scope combines extra-natural B−L inflation, brane-localized Standard Model matter, particle-physics connections and decay-controlled reheating.",
      "qualification": "n1 covers the gauge-sector inflationary observables, particle-physics connection and reheating determined by restricted decays. q4 identifies this setting as a related alternate home, while q17 covers the reheating component; neither supplies the whole defined question. Brane-localized matter is not evidence for a brane-position inflaton.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:04be111e484dcf67f35dbc1b917e98f22fca36b0513f5d52dad34cb942207c66",
          "paperId": "1310.4646",
          "textSha256": "571754ee8ba94642090b0ca98992455432390eb8755b7f11ce6c348cb025e340"
        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0069:u5:n1"
    },
    {
      "unitId": "unit:daf963863b3abb21285f1347d6a74e10205685cc5c4fcefc43d8e218850d3f85",
      "destinationId": "q025-placement-question:3be1cc8035532d213ca580a6",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "The proposed scope preserves Standard Model vacuum classification, stability and conditional conjecture and neutrino implications.",
      "qualification": "n2 covers Standard Model compactification vacua, their stability and the conditional implications involving nonsupersymmetric AdS conjectures and multiple point criticality. q11 lacks the classification and neutrino-parameter targets. Neither an unspecified geometry nor an unconditional neutrino bound is added.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:daf963863b3abb21285f1347d6a74e10205685cc5c4fcefc43d8e218850d3f85",
          "paperId": "1707.06326",
          "textSha256": "048315d50eab885c822313242d54b3a6e42409f03b35201761ea0fbf4e3f421f"
        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0069:u7:n2"
    },
    {
      "unitId": "unit:0259ff31d3a9b71a15c7fe788ebbcd978bca887cce9e6aee288271ad2925006a",
      "destinationId": "q025-placement-question:91afb864c82318f82559258f",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "The proposed scope jointly evaluates tower, light-modulus and nonsupersymmetric-decay conditions for scale-separated effective AdS solutions.",
      "qualification": "n3 preserves all three proposed consistency tests in their common effective-AdS setting. q18's cutoff and light-sector questions do not independently include nonsupersymmetric decay, and q11's stability scope does not specify the full tower-and-modulus conjectural tests. Passing one test is not equated with passing the others.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:0259ff31d3a9b71a15c7fe788ebbcd978bca887cce9e6aee288271ad2925006a",
          "paperId": "2202.00682",
          "textSha256": "ee33eed6318acc1f3ad4b3d7e58132f614febe07fc9af7a0a1673a4dc8fe0521"
        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0069:u8:n3"
    },
    {
      "unitId": "unit:e419f5203399437634947f8bf71f51cb484df369673771bfd1b7c3d2ca3f5404",
      "destinationId": "q025-placement-question:7e8fc247c20abc0589f8c628",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "The proposed scope covers both supersymmetric AdS5 scale separation and trustworthy dS5 effective descriptions under indirect quantum-gravity tests.",
      "qualification": "n4 covers both the supersymmetric AdS5 hierarchy and dS5 effective-description targets while preserving the restriction to indirect constraints. q18 is explicitly an AdS scope; q11 does not supply this paired five-dimensional obstruction question. No direct vacuum prohibition is assumed.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:e419f5203399437634947f8bf71f51cb484df369673771bfd1b7c3d2ca3f5404",
          "paperId": "2303.04162",
          "textSha256": "4f2de4ba7b1635fd9293f12332202d8ad46b63371a27f711f4afc2274935280c"
        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0069:u9:n4"
    },
    {
      "unitId": "unit:0d08d4f774b65ee2bf1501e8473ec7d3cc295913993a539ece15bec5a90b9309",
      "destinationId": "q025-placement-question:becf65a62223b0377d5c3eff",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "The proposed scope jointly covers profiled-circle reduction to effective dS and the associated KK-spectrum test of the strong AdS distance conjecture.",
      "qualification": "n5 retains both the profiled circle reduction to effective dS and the separate strong-ADC spectral-evidence question. q11 covers the effective-vacuum target but not the conjecture-evidence target; q1's KK/AdS separation question does not cover the full reduction problem. The nonconstant profile and the limited meaning of bottom-up evidence remain explicit.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:0d08d4f774b65ee2bf1501e8473ec7d3cc295913993a539ece15bec5a90b9309",
          "paperId": "2202.04489",
          "textSha256": "4b9b1591bdb59e070d1a68f3e318c55659be3421d3499153999654891cb6e4fe"
        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0069:u13:n5"
    },
    {
      "unitId": "unit:0493bc9c589803bd7df6fcbbe5294d7b35bb48f6539a78b354a138831f9825a3",
      "destinationId": "q025-placement-question:665fc3d4dc64ff4988f46f31",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "The proposed scope directly covers the relation between a chosen coupling histogram, α-state probabilities and a Euclidean gravitational prescription.",
      "qualification": "n6 preserves the chosen histogram as input and both the α-state probabilities and Euclidean prescription as targets. q21 identifies gravitational probability measures as adjacent to its entropy program rather than establishing an entropy-bound home for them. A formula or microscopic interpretation is unnecessary for this bounded placement and is not supplied.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:0493bc9c589803bd7df6fcbbe5294d7b35bb48f6539a78b354a138831f9825a3",
          "paperId": "2111.06404",
          "textSha256": "0d281b1c27930be451ca3e41309aca9860201a8c88ab3c2dcdd3102dce08aae9"
        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0069:u28:n6"
    },
    {
      "unitId": "unit:ea6471e7ee6570a9ac8ce3bd199784a6a2a2fa7126f1945443c59b43fc0db8e1",
      "destinationId": "q025-placement-question:9adee06c4afa3264abbfec55",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "The proposed scope preserves the vacuum information-distance question at both vanishing and infinite oscillator frequency.",
      "qualification": "n7 covers the oscillator vacuum, its information distance and both frequency limits. q21 treats information geometry as adjacent, while q16's entropy and information-constraint targets do not supply this vacuum-distance question. The unspecified metric formula prevents a derivation here, not identification of the complete organizational target.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:ea6471e7ee6570a9ac8ce3bd199784a6a2a2fa7126f1945443c59b43fc0db8e1",
          "paperId": "2106.11313",
          "textSha256": "a24af087694d6d00345e0de9852c8ecad0b09b702e1538c2a020986083957174"
        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0069:u29:n7"
    },
    {
      "unitId": "unit:c7324d49ff27c430ae1716c482542699b7bf5151ebe23e5f106e23ddb2966791",
      "destinationId": "q025-placement-question:07f75c122772af108382b804",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "The proposed composite question covers both long-range SYK spectra and scrambling and protected boundary Yukawa-SYK operator data, with their dimensions and mechanisms kept distinct.",
      "qualification": "n0 preserves the full compound question. q29 covers long-range spectra, chaos and spatial scrambling but limits its boundary construction to a chaos observable; q3 covers conformal data and free-bulk protection without the spatial-scrambling program. Neither is independently complete. The supplied regions do not establish a suitable whole home solely from SYK or bulk–boundary terminology. Retaining the supported composite n0 avoids a union while preserving separate dimensions and protection mechanisms.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:c7324d49ff27c430ae1716c482542699b7bf5151ebe23e5f106e23ddb2966791",
          "paperId": "2308.12598",
          "textSha256": "8964c60caf96cd1e3cdc2182c2da64c1f3c492e1b1363ff9d042be8a00423ee8"
        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0074:u26:n0"
    }
  ],

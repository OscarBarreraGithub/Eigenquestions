      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "Covers curvature-dependent stability of scalar–fluid scaling solutions and both temporal asymptotic limits of expanding Robertson–Walker models.",
      "qualification": "n10 covers stability under admitted spatial curvature and both asymptotic directions for expanding scalar–fluid Robertson–Walker models. q5's moduli geometry and n2's kinetic field-space dynamics concern different curvature and evolution targets.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:0451ea791f106674b6ae4dd220aaa37b25218f2646c5278ee742c1a6e5f81504",

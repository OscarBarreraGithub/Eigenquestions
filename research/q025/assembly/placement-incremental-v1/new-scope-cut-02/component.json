    },
    {
      "unitId": "unit:3cf01eca46c2fe19ec950e902ea40c0b0e4229b189bff2924b9d206f4e14e59d",
      "destinationId": "q025-placement-question:44697e3691f6e44e3e1e1bb0",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "Covers homogeneous multifield background dynamics determined jointly by potential gradients, Hubble friction and field-space connection forces.",
      "qualification": "n2 covers the joint background evolution generated by all three named forces in the homogeneous multifield regime. q2 concerns instanton-dependent vacuum dynamics, while q5 concerns moduli geometry and accessible domains; neither covers this general cosmological evolution question.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:3cf01eca46c2fe19ec950e902ea40c0b0e4229b189bff2924b9d206f4e14e59d",
          "paperId": "1903.06116",

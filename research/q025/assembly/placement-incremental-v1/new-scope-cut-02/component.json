      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "Covers the dependence of limiting KM-state purity on the observables surviving ensemble averaging and double scaling.",
      "qualification": "n8 covers observable selection, the ensemble-averaged double-scaling limit and purity relative to the emergent algebra. None of the supplied existing scopes covers that operator-algebra target; initial purity does not predetermine its answer.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:e950a4a9e0c3f8cf3484be6d530b8a6a63216f84d81bba8f914b3d64c108acda",

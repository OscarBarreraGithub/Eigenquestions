      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "Covers large-N random Dirac spectral constraints obtained from Schwinger–Dyson consistency and moment positivity without explicit multitrace, multimatrix solutions.",
      "qualification": "n6 covers the combined consistency/positivity strategy, random Dirac spectral target, large-N regime and avoidance of explicit multitrace, multimatrix solution. None of the supplied q* definitions covers that problem.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:5725c6aa774b18e89c8af2990edf6321e5de778b69207580aae3d9e3b798a29b",

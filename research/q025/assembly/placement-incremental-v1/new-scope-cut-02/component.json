        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0014:u22:n2"
    },
    {
      "unitId": "unit:1dc49a878e8b206f4a56ba197748a2af221312c767a3a300b623ad7a31ca2566",
      "destinationId": "q025-placement-question:44697e3691f6e44e3e1e1bb0",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "Covers quasi-de Sitter multifield backgrounds with curved kinetic geometry and a distinction between the total gradient and actual background motion.",
      "qualification": "n2 explicitly covers curved kinetic geometry, the quasi-de Sitter background and the distinction between total gradient and actual motion. Its general force question and this application form a valid composite home without equating u31 with u22 or imposing quasi-de Sitter behavior on every multifield solution.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:1dc49a878e8b206f4a56ba197748a2af221312c767a3a300b623ad7a31ca2566",

      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "Covers an independently justified prohibition of non-invertible topological operators and a noncircular implication to completeness.",
      "qualification": "n5 includes the operator prohibition, independent justification and noncircular derivation of completeness. q7's specified charge, anomaly and generalized-symmetry models do not cover this entire principle-level question. An established answer is not a prerequisite for placing the question.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:8fe0d15685de104a1e722a1ea8e9760aab859192ae93400289220e1b36f20cb3",

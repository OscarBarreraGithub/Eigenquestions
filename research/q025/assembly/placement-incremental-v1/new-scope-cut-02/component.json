        }
      ],
      "decisionId": "decision:placement-new-scope-home:placement-continuation-0014:u3:n0"
    },
    {
      "unitId": "unit:1a7bb8b466813a46cd781eb458484122b6450008a2740cd27a0ea6eee97a3ac3",
      "destinationId": "q025-placement-question:c2c4d376fded4fd9ec845c4f",
      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "Covers identification of light towers along an AdS family approaching zero cosmological constant.",
      "qualification": "n1 directly covers tower identification in the stated AdS limit. q4's AdS instanton solutions and q5's distance/curvature targets do not supply this spectral question; no unspecified tower, dimension or scaling exponent is added.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:1a7bb8b466813a46cd781eb458484122b6450008a2740cd27a0ea6eee97a3ac3",

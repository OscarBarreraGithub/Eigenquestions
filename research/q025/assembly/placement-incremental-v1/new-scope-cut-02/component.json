      "role": "member",
      "status": "accepted",
      "basis": "description_checked",
      "allocationWeight": 1,
      "reason": "Covers the instanton-only limit, observables beyond the BPS sector and perturbation theory without linearizing field space.",
      "qualification": "q4 expressly includes instanton-only solvable limits, but its stated solution, action, topology, moduli and background-consistency targets do not establish coverage of perturbation theory for general observables. q1 and q8 likewise do not supply that full observable target. n0 covers the limit and its proposed nonlinear-field-space calculus together.",
      "evidenceRefs": [
        {
          "kind": "description",
          "unitId": "unit:a15161de2dbf09b20b49e55a9b7c3f728dc6ef954e66622e73bbe21c96332abc",

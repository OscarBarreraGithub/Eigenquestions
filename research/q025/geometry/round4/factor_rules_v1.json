{
  "schemaVersion": "q025-source-span-factor-rules/1",
  "status": "development_prototype_requires_independent_source_challenge",
  "hypothesis": "Typed scope factors can distinguish same-scope suggestions from framework, target and method bridges without deleting geometric or scientific connections.",
  "inputPolicy": "Use exact question-description spans only for this automatic draft. Do not inherit assumptions from paper-wide or co-record context. Independently reviewed source qualifications may be separate attributed records, never invisible rule exceptions.",
  "identityPolicy": "A shared factor is an organizational link, not question equivalence, implication, membership truth or physical compatibility.",
  "rules": [
    {"role":"system","value":"kk_graviton_tower","patterns":["KK[ -]graviton(?:s| tower)?","graviton[ -]dark[ -]matter","graviton dark matter"],"specific":true},
    {"role":"system","value":"kk_gauge_bosons","patterns":["KK gauge boson"],"specific":true},
    {"role":"system","value":"ultrahigh_energy_cosmic_rays","patterns":["ultrahigh[ -]energy cosmic[ -]ray(?:s)?","UHECR"],"specific":true},
    {"role":"system","value":"axion_or_pseudoscalar","patterns":["axion(?:s)?","pseudoscalar(?:s)?"],"specific":true},
    {"role":"system","value":"nonabelian_gauge_sector","patterns":["non-Abelian (?:gauge |field|sector)","SU\\(2\\)","Chromo-Natural","chromonatural","chromo-natural","gauge-flation"],"specific":true},
    {"role":"system","value":"curvaton","patterns":["curvaton"],"specific":true},
    {"role":"system","value":"vector_field","patterns":["vector field","massive vector","vector spectator"],"specific":true},
    {"role":"system","value":"scalar_field","patterns":["scalar field","single-field","scalar-field","scalar Lagrangian","scalar Warm Little","massive scalar"],"specific":false},
    {"role":"system","value":"inflaton","patterns":["inflaton"],"specific":false},
    {"role":"system","value":"graviton_condensate","patterns":["graviton composites","gravitational-wave condensate","gravitational Chern.Simons condensate","graviton squeezing"],"specific":true},
    {"role":"framework","value":"dark_dimension","patterns":["dark[ -]dimension","dark extra dimension"],"specific":true},
    {"role":"framework","value":"extra_dimensions","patterns":["extra dimension(?:s)?","large extra dimensions"],"specific":false},
    {"role":"framework","value":"warm_inflation","patterns":["Warm Little Inflation","warm (?:Higgs )?inflation"],"specific":true},
    {"role":"framework","value":"rapid_turn_or_hyperinflation","patterns":["rapid-turn","rapid trajectory turning","hyperinflation","sharp turns","turning backgrounds"],"specific":true},
    {"role":"framework","value":"dbi_or_dcceleration","patterns":["DBI","D-cceleration"],"specific":true},
    {"role":"framework","value":"axion_monodromy","patterns":["axion.monodromy","monodromy inflation"],"specific":true},
    {"role":"framework","value":"fibre_inflation","patterns":["Fibre Inflation"],"specific":true},
    {"role":"framework","value":"starobinsky_or_curvature_inflation","patterns":["Starobinsky","f\\(R\\)","curvature-driven","quadratic high-curvature scalaron"],"specific":true},
    {"role":"framework","value":"string_compactification","patterns":["type IIB","type-IIB","D3-brane","KKLT","string-derived","string-inspired","string inflation","moduli stabilization"],"specific":false},
    {"role":"framework","value":"loop_quantum_cosmology","patterns":["LQC"],"specific":true},
    {"role":"framework","value":"inflation","patterns":["inflation(?:ary)?"],"specific":false,"respectInflationPolarity":true},
    {"role":"target","value":"pbhs_and_abundance","patterns":["primordial[ -]black[ -]hole(?:s)?","primordial black holes","PBH(?:s)?"],"specific":true},
    {"role":"target","value":"small_scale_scalar_enhancement","patterns":["small-scale (?:curvature |scalar )?(?:fluctuations|perturbations|power|curvature spectrum)","enhanced primordial perturbations","scalar enhancement","curvature enhancement"],"specific":true},
    {"role":"target","value":"gravitational_wave_or_tensor_signatures","patterns":["gravitational.wave(?:s)?","CMB tensors","tensor (?:CMB |perturbation |perturbations|spectrum|spectra|predictions)","primordial tensors","chiral tensors"],"specific":false},
    {"role":"target","value":"primordial_scalar_or_curvature_spectra","patterns":["curvature perturbation(?:s)?","primordial density fluctuations","scalar (?:tilt|spectrum|spectra|power spectrum)","scalar and tensor spectra","curvature spectra"],"specific":false},
    {"role":"target","value":"non_gaussianity","patterns":["non-Gaussianity","non-Gaussian","bispectr(?:um|a)","Gaussianity"],"specific":true},
    {"role":"target","value":"particle_or_dark_matter_production","patterns":["gravitational production","inflationary production","initial (?:tower )?abundance","production from a hot","produce dark matter","supply viable dark matter","supply dark matter","producing dark matter"],"specific":true},
    {"role":"target","value":"decay_amplitudes_and_rates","patterns":["three-point amplitude","partial-wave suppression","cascade suppression","cascade rate","intra-tower (?:KK graviton )?decays","intratower decays"],"specific":true},
    {"role":"target","value":"cosmological_recoil_signatures","patterns":["linear cosmological signatures","kick velocity","repeated decays"],"specific":true},
    {"role":"target","value":"decay_product_or_cooling_bounds","patterns":["CMB energy deposition","stellar cooling bounds","constraints from Standard Model decay products","Galactic positron production"],"specific":true},
    {"role":"target","value":"uhecr_cutoff","patterns":["GZK","UHECR cutoff","cutoff and ankle","source-associated spectra","universal UHECR cutoff","observed UHECR suppression"],"specific":true},
    {"role":"target","value":"cmb_compatibility","patterns":["CMB (?:constraints|observations|predictions|bounds|observables)","CMB-compatible","cosmological data","observational constraints","observationally viable"],"specific":false},
    {"role":"target","value":"quantum_gravity_consistency","patterns":["quantum-gravity (?:consistency |conjectures|restrictions)","weak gravity conjecture","swampland","refined de Sitter"],"specific":true},
    {"role":"target","value":"stability_or_control","patterns":["stability","stable backgrounds","healthy metric","backreaction","controlling quantum corrections","control curvature","perturbatively small","instabilit"],"specific":true},
    {"role":"target","value":"initial_condition_sensitivity","patterns":["initial position","initial condition","initial-condition","initial velocity"],"specific":true},
    {"role":"target","value":"spatial_curvature_or_bubble_history","patterns":["spatial curvature","bubble nucleation","tunneling origin","landscape tunneling"],"specific":true},
    {"role":"regime","value":"linear_perturbations","patterns":["linear (?:adiabatic|scalar|quantum|cosmological|perturbation)"],"specific":true},
    {"role":"regime","value":"near_threshold","patterns":["near threshold","near-threshold"],"specific":true},
    {"role":"regime","value":"slow_roll","patterns":["slow-roll","slow roll"],"specific":true},
    {"role":"regime","value":"ultra_slow_roll","patterns":["ultra-slow roll","USR"],"specific":true},
    {"role":"regime","value":"late_or_post_inflation","patterns":["post-inflationary","postinflationary","after inflation","reheating","pre-BBN","late-time"],"specific":true},
    {"role":"regime","value":"near_end_of_inflation","patterns":["near the end of","end of quartic inflation"],"specific":true},
    {"role":"regime","value":"no_inflation","patterns":["without inflation"],"specific":true},
    {"role":"regime","value":"without_contraction","patterns":["without inflation, contraction"],"specific":true},
    {"role":"regime","value":"strong_dissipation","patterns":["strong dissipation","strong-dissipation","strongly dissipative"],"specific":true},
    {"role":"regime","value":"weak_dissipation","patterns":["weak dissipation","weak-dissipation","weakly dissipative"],"specific":true},
    {"role":"assumption_mentioned","value":"quartic_potential","patterns":["quartic inflation","quartic potential"],"specific":true},
    {"role":"assumption_mentioned","value":"curved_field_space","patterns":["curved field space","curved scalar-field space","field-space geometry","curved scalar target spaces","field-space curvature"],"specific":true},
    {"role":"assumption_mentioned","value":"constant_curvature_restriction","patterns":["constant-curvature restriction"],"specific":true}
  ],
  "negativeScopePolicy": "A literal without-inflation span prevents a positive inflation-framework assignment from that same occurrence. Post/pre-inflationary occurrences are temporal context, not evidence that the target phase is inflation. Such sources remain connected through shared targets, frameworks or explicit method routes.",
  "unknownPolicy": "No match means not extracted by these rules, never absence of that physical feature. Warm weak/strong phase histories and other source-specific premises are not inferred from generic warm-inflation labels."
}

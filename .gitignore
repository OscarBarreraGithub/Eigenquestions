# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
__pycache__/
*.pyc

# next.js
/.next/
/out/

# production
/build
/dist/

# Local navigation sessions, bridge receipts and portable output
/.navigation/
/navigation-output/
/tmp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite
data/*.db
data/*.db-wal
data/*.db-shm

# cloudflare
.open-next/
.wrangler/

# Local-only primary-source QA excerpts and private review notes
/research/q025/**/*.local.json
/research/q025/**/native-local/
/docs/Q-015-swampwiki-review.md

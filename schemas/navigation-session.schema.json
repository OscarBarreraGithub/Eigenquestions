{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigenquestions.com/schemas/navigation-session.schema.json",
  "type": "object",
  "required": ["schemaVersion", "corpusId", "computationId", "states", "cursor"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "corpusId": {"type": "string", "minLength": 1},
    "computationId": {"type": "string", "minLength": 1},
    "states": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "navigation-state.schema.json"}},
    "cursor": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}

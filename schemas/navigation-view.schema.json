{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigenquestions.com/schemas/navigation-view.schema.json",
  "title": "Eigenquestions native and prepared views",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "corpusId",
        "computationId",
        "stateId",
        "nodes",
        "edges",
        "directions",
        "chart",
        "diagnostics",
        "warnings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "corpusId": {
          "type": "string"
        },
        "computationId": {
          "type": "string"
        },
        "stateId": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "paperId",
              "x",
              "y",
              "score",
              "residual",
              "evidence"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "paperId": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "score": {
                "type": "number"
              },
              "residual": {
                "type": "number"
              },
              "evidence": {
                "type": "object"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target",
              "type",
              "weight"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              }
            }
          }
        },
        "directions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "query",
              "seedIds",
              "evidenceIds"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "seedIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "chart": {
          "type": "object"
        },
        "diagnostics": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schemaVersion",
        "corpusId",
        "computationId",
        "stateId",
        "nodes",
        "directions",
        "edges",
        "chart",
        "diagnostics",
        "warnings",
        "atlas"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.1.0"
        },
        "corpusId": {
          "type": "string"
        },
        "computationId": {
          "type": "string"
        },
        "stateId": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "maxItems": 500
        },
        "directions": {
          "type": "array",
          "maxItems": 15
        },
        "edges": {
          "type": "array"
        },
        "chart": {
          "type": [
            "object",
            "null"
          ]
        },
        "diagnostics": {
          "type": "object"
        },
        "warnings": {
          "type": "array"
        },
        "atlas": {
          "type": "object",
          "required": [
            "selector",
            "destination",
            "membershipCount",
            "matchingSourceCount",
            "connections"
          ],
          "properties": {
            "selector": {
              "$ref": "navigation-state.schema.json#/properties/selector"
            },
            "destination": {
              "type": "object"
            },
            "membershipCount": {
              "type": "integer",
              "minimum": 0
            },
            "matchingSourceCount": {
              "type": "integer",
              "minimum": 0
            },
            "connections": {
              "type": "array"
            }
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigenquestions.com/schemas/navigation-state.schema.json",
  "title": "Eigenquestions navigation state 1.0.0 / prepared 1.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "corpusId",
    "computationId",
    "query",
    "focusIds",
    "intent",
    "workRelation",
    "lens",
    "constraints"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "corpusId": {
      "type": "string",
      "minLength": 1
    },
    "computationId": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "maxLength": 4000
    },
    "focusIds": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "intent": {
      "enum": [
        "explore",
        "derive",
        "phenomenology",
        "recent",
        "using"
      ]
    },
    "workRelation": {
      "enum": [
        "on",
        "using",
        "either"
      ]
    },
    "lens": {
      "enum": [
        "physical_question",
        "method",
        "combined"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excludeIds": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "yearMin": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3000
        },
        "yearMax": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3000
        }
      }
    },
    "selector": {
      "type": "object",
      "required": [
        "kind",
        "atlasId",
        "atlasVersion",
        "destinationId"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "atlas-destination"
        },
        "atlasId": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "atlasVersion": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "destinationId": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        }
      }
    },
    "sourceInspection": {
      "type": "object",
      "description": "Presentation/history focus on an exact reviewed source-relation endpoint; does not change scientific destination identity.",
      "required": [
        "originUnitId",
        "relationId",
        "objectId",
        "unitId"
      ],
      "additionalProperties": false,
      "properties": {
        "originUnitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "relationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "objectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "unitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "selector"
        ]
      },
      "else": {
        "not": {
          "required": [
            "selector"
          ]
        }
      }
    }
  ],
  "dependentRequired": {
    "sourceInspection": [
      "selector"
    ]
  }
}

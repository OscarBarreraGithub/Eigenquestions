ionCount":1,"detail":{"shardId":"destination-details-fine-0075"},"indexTemplate":"source_question"},{"id":"source-question:f23d3e847bed01a8b41416ca840365dbe0f4686490c23c5f790ce6861b80ebc1","title":"How do higher-derivative terms and background five-branes alter heterotic EFT couplings and string charges?","connectionCount":1,"detail":{"shardId":"destination-details-fine-0077"},"indexTemplate":"source_question"},{"id":"source-question:f2d16e1773e3c5b168c1d70e06c2819a1ddcd0ba1b980a8a42919a192ed1db5c","title":"Can geometric flows preserve Einstein equations for gravity coupled to matter, and can discrepancies between action-induced flows and this requirement motivate additional light states?","connectionCount":1,"detail":{"shardId":"destination-details-fine-0078"},"indexTemplate":"source_question"},{"id":"source-question:f22fd7e8660eabb03929a30b940e15091355f8c4417a432d80bb06bd86a50a3f","title":"Can holographic CFTs retain weak gravitational interactions while selected matter operators fail large-N factorization, thereby allowing matter interactions at the AdS scale rather than only Planck-suppressed interactions?","connectionCount":1,"detail":{"shardId":"destination-details-fine-0079"},"indexTemplate":"source_question"},{"id":"source-question:f27f3ad38a3e91b0411be91b0a858ea14ae312c4dbd914b70018f4fd15e3cfcc","title":"Can small higher-curvature corrections produce large physical effects at extremal or near-extremal black-hole horizons despite small ambient curvature?","connectionCount":1,"detail":{"shardId":"destination-details-fine-0081"},"indexTemplate":"source_question"},{"id":"source-question:f20fb76c2ef977f440b3c6f9dbbcef5e86b3301dbe1cc0933abc1aec94583be9","title":"Can classical rolling of misalignment-produced axion dark matter generate observable isocurvature during low-scale inflation, and thereby impose a lower inflationary Hubble bound with distinctive correlation and spectral-index predictions?","connectionCount":1,"detail":{"shardId":"destination-details-fine-0082"},"indexTemplate":"source_question"},{"id":"source-question:f204135166a4c701563f0b31b9dea7b1d5b39b6a5e2075a2105a863259513413","title":"What are the spin cobordism groups of the classifying space of the actual type I/heterotic gauge group through dimension 12, and what nonperturbative charges and trivialization mechanisms might they describe?","connectionCount":1,"detail":{"shardId":"destination-details-fine-0089"},"indexTemplate":"source_question"},{"id":"source-question:f27fb120180f67ee5cccfb3cae720ae8f0a247a586256df1f446198cdc7bebbc","title":"Can an exponentially coupled quintessence–IDM framework support observationally viable inflation and effective late-time acceleration, and do its curved field space and multifield dynamics alleviate the refined de Sitter Swampland tension?","connectionCount":1,"detail":{"shardId":"destination-details-fine-0098"},"indexTemplate":"source_question"},{"id":"source-question:f2bc92e30464744b9f40d3a136fa98cf455e48d3aae16efe75d8773d4e91f7d4","title":"Can Hořava–Witten theory realize a single large dark dimension while retaining realistic gauge couplings, avoiding rapid proton decay and controlling quantum corrections?","connectionCount":1,"detail":{"shardId":"destination-details-fine-0100"},"indexTemplate":"source_question"},{"id":"source-question:f21bcf6117aeb09d9860eccd259ce184cb36adbb1d0bcaa6798c0c9a0fe23b46","title":"Can rotating five-dimensional primordial black holes survive as dark matter in the Dark Dimension scenario, and can their formation-associated scalar-induced gravitational waves constrain their properties and memory-burden evaporation?","connectionCount":1,"detail":{"shardId":"destination-details-fine-0100"},"indexTemplate":"source_question"},{"id":"source-question:f27d5df1a437ed312f4c867dfc1b3079ba63b7aa4d37fe9b690f30d95591086e","title":"Which asymptotic properties of 4d N=2 vector multiplet moduli spaces follow from supersymmetry alone, and which require quantum gravity input concerning light towers, charge c